# Strong independent secrets: generate each with secrets.token_urlsafe(48).
PAGEFPT_ENVIRONMENT=development
PAGEFPT_SUPABASE_URL=
PAGEFPT_SUPABASE_SECRET=
# Publishable or legacy anon key for the server Auth adapter, never service-role.
PAGEFPT_SUPABASE_AUTH_KEY=
PAGEFPT_ADMIN_SESSION_HOURS=12
PAGEFPT_ENCRYPTION_KEY=
PAGEFPT_ENCRYPTION_KEY_VERSION=v1
PAGEFPT_ENCRYPTION_PREVIOUS_KEYS={}
PAGEFPT_MATCHING_KEY=
PAGEFPT_TOKEN_KEY=
PAGEFPT_JOB_SECRET=
PAGEFPT_ALLOWED_ORIGINS=[]
PAGEFPT_PUBLIC_ORIGIN=
# Enable only behind Vercel's trusted proxy.
PAGEFPT_TRUSTED_VERCEL_PROXY=false
PAGEFPT_TURNSTILE_SECRET=
PAGEFPT_TURNSTILE_HOSTNAMES=[]
PAGEFPT_R2_ENDPOINT=
PAGEFPT_R2_ACCESS_KEY=
PAGEFPT_R2_SECRET_KEY=
PAGEFPT_R2_BUCKET=
PAGEFPT_R2_PUBLIC_BUCKET=
PAGEFPT_MEDIA_DOMAIN=
PAGEFPT_GEOIP_PATH=
# Preview/staging defaults: no real messages or ads calls.
PAGEFPT_INTEGRATIONS_ENABLED=false
PAGEFPT_NOTIFICATION_URL=
PAGEFPT_NOTIFICATION_SECRET=
PAGEFPT_TELEGRAM_ENABLED=false
PAGEFPT_TELEGRAM_BOT_TOKEN=
PAGEFPT_TELEGRAM_CHAT_ID=
PAGEFPT_TELEGRAM_ADMIN_ORIGIN=

PAGEFPT_CONVERSION_URL=
PAGEFPT_CONVERSION_SECRET=
PAGEFPT_INCOMING_WEBHOOK_SECRET=

# Server-only recovery routing; never use a group ID for password codes.
# Shared private recipient for every eligible Admin/staff recovery request.
PAGEFPT_TELEGRAM_RECOVERY_CHAT_ID=
# Legacy per-email bindings, used only when shared recovery is not configured.
PAGEFPT_TELEGRAM_RECOVERY_ACCOUNTS={}
